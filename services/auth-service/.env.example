APP_ENV=development
# Port 8081 may be in use by another local service (e.g. Java). Use 8083 if needed.
HTTP_PORT=8083

# Local PostgreSQL 18 — single shared database for all KrewOps services
DATABASE_URL=postgres://postgres:your-password@localhost:5432/krewops?sslmode=disable

JWT_SECRET=
JWT_ACCESS_EXPIRY_MINUTES=60

OTP_EXPIRY_MINUTES=5
