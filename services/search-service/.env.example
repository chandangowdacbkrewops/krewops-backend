APP_ENV=development
HTTP_PORT=8086
GRPC_PORT=50055

# Worker search still reads PostgreSQL tables owned by user-service.
DATABASE_URL=postgres://postgres:your-password@localhost:5432/krewops?sslmode=disable

# Work search reads job postings from MongoDB.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=krewops

JWT_SECRET=
